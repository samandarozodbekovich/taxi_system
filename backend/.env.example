# Copy to backend/.env and fill in. Never commit backend/.env.

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
# True only for local development
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.example
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-domain.example
# Number of proxies in front of Django (ngrok / nginx = 1, none = 0)
DJANGO_NUM_PROXIES=0

# --- PostgreSQL + PostGIS ---
DB_NAME=taxi_system_db
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Redis (Channels, Celery, cache) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Telegram ---
# Client bot token: verifies Mini App initData signatures
CLIENT_BOT_TOKEN=
# Shared secret for client bot -> backend requests (same value in bots/client_bot/.env)
BOT_API_SECRET=
# Driver bot token: new-order notifications to drivers
DRIVER_BOT_TOKEN=
# Driver panel URL, e.g. https://your-domain.example/api/drivers/panel/
DRIVER_WEBAPP_URL=

# --- Maps and routing ---
# Yandex Maps JavaScript API key (public; restrict it to your domain in the Yandex developer console)
YANDEX_FRONTEND_MAP_KEY=
# Your own OSRM server, e.g. http://localhost:5000. Empty = public demo server (testing only)
OSRM_BASE_URL=
