# Copy to bots/driver_bot/.env and fill in. Never commit the .env file.

# Driver bot token (from @BotFather) - the same as DRIVER_BOT_TOKEN in backend/.env
DRIVER_BOT_TOKEN=
# Backend URL, e.g. http://127.0.0.1:8000
API_BASE_URL=http://127.0.0.1:8000
# Driver panel URL, e.g. https://your-domain.example/api/drivers/panel/
DRIVER_WEBAPP_URL=
# Same as BOT_API_SECRET in backend/.env
BOT_API_SECRET=
# Redis for bot sessions (driver login tokens survive restarts)
REDIS_URL=redis://localhost:6379/3
