# Copy to bots/client_bot/.env and fill in. Never commit the .env file.

# Client bot token (from @BotFather) - the same bot as CLIENT_BOT_TOKEN in backend/.env
TELEGRAM_BOT_TOKEN=
# Backend URL, e.g. http://127.0.0.1:8000
API_URL=http://127.0.0.1:8000
# Same as BOT_API_SECRET in backend/.env
BOT_API_SECRET=
# Client Mini App URL (opened by the "Call a taxi" button), e.g. https://your-domain.example/
WEBAPP_URL=
