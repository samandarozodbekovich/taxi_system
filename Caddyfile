# HTTPS reverse proxy in front of the backend (see the caddy service in docker-compose.yml).
# Caddy gets a Let's Encrypt certificate for DOMAIN and redirects HTTP to HTTPS.
# Access logs are off (no `log` directive): the order WebSocket carries initData in the query string.

{$DOMAIN:localhost} {
	encode gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Django: HTTP, WebSocket, static files (WhiteNoise) and /media/ - driver photos are
	# served by Django to admin staff only, so Caddy must not serve the media volume itself.
	# Caddy sets X-Forwarded-For / X-Forwarded-Proto, so DJANGO_NUM_PROXIES=1.
	reverse_proxy backend:8000
}
